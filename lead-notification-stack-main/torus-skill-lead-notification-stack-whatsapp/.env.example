# Torus Skill: lead-notification-stack-whatsapp
# Copy this file to .env.local (Next.js) and fill in real values per project.
# NEVER commit a filled-in .env file. NEVER put SUPABASE_SERVICE_ROLE_KEY
# or any secret behind a NEXT_PUBLIC_ prefix.

# --- Supabase (server-only) ---------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Server-side only. Bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Resend (email notifications) ---------------------------------------
RESEND_API_KEY=re_your_resend_api_key
# Must be on a domain verified in your Resend account.
RESEND_FROM_EMAIL=notifications@your-verified-domain.example
LEAD_NOTIFICATION_TO_EMAIL=internal-team@your-company.example

# --- n8n (WhatsApp orchestration) ----------------------------------------
# Must be the PRODUCTION webhook path (/webhook/...), not /webhook-test/...
N8N_PRODUCTION_WEBHOOK_URL=https://your-n8n-instance.example/webhook/your-webhook-path
# Shared secret checked by n8n against the x-torus-webhook-secret header.
N8N_WEBHOOK_SECRET=your-long-random-shared-secret

# --- Meta WhatsApp Cloud API (used inside the n8n workflow, not in this API route) ---
# v1 note: a Meta temporary test token expires ~24h and is fine for dev only.
# Production deployments must use a Meta System User token (or equivalent
# permanent token). See docs/META_WHATSAPP_SETUP.md.
META_WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-access-token
META_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
META_WHATSAPP_RECIPIENT_NUMBER=15555550123
